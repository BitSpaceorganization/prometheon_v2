"""Prometheon V2 canonical chute wrapper.

Rendered per miner with exactly four values. Everything else is fixed, and
validators verify that by fetching this source from the Chutes API, masking the
four values, normalising the AST, and comparing the hash. Any other edit makes
the deployment invalid.

The wrapper owns integrity and transport. The engine owns loading and
inference. Neither is miner-modifiable.
"""

from __future__ import annotations

import hashlib
import importlib.util
import sys
from pathlib import Path
from typing import Any

from chutes.chute import Chute, NodeSelector
from chutes.image import Image
from fastapi import HTTPException, status
from huggingface_hub import snapshot_download
from pydantic import BaseModel, Field
from yaml import safe_load

# --- Approved variables: the only per-miner values in this file -------------
PROMETHEON_HF_REPO = "{{ hf_repo }}"
PROMETHEON_HF_REVISION = "{{ hf_revision }}"
PROMETHEON_CHUTES_USER = "{{ chutes_user }}"
PROMETHEON_CHUTE_ID = "{{ chute_id }}"

# --- Fixed below this line --------------------------------------------------
WRAPPER_VERSION = "prometheon-moderation/1"

PROMETHEON_ENGINE_SCRIPT = "miner.py"
PROMETHEON_ENGINE_CLASS = "Engine"
PROMETHEON_REPO_CONFIG = "chute_config.yml"

# SHA-256 of the canonical engine. A repo whose miner.py differs by one byte
# does not start.
PROMETHEON_CANONICAL_ENGINE_SHA256 = "{{ engine_sha256 }}"

# Every file a repository may contain. Anything else and the chute refuses to
# start — an unlisted file is a place to hide code the hash checks never see.
PROMETHEON_FILE_MANIFEST = frozenset(
    {
        ".gitattributes",
        ".gitignore",
        "README.md",
        "chute_config.yml",
        "config.json",
        "generation_config.json",
        "merges.txt",
        "miner.py",
        "model.safetensors",
        "model.safetensors.index.json",
        "special_tokens_map.json",
        "tokenizer.json",
        "tokenizer.model",
        "tokenizer_config.json",
        "vocab.json",
    }
)

# Sharded weights are the one legitimate variable-name case.
PROMETHEON_SHARD_PREFIX = "model-"
PROMETHEON_SHARD_SUFFIX = ".safetensors"

MAX_ITEMS_PER_REQUEST = 100
MAX_POLICY_CHARS = 64000
MAX_CONTENT_CHARS = 32000


class ModerationItem(BaseModel):
    id: str = Field(..., min_length=1, max_length=128)
    content: str = Field(..., max_length=MAX_CONTENT_CHARS)


class ModerationRequest(BaseModel):
    policy_version: str = Field(..., min_length=1, max_length=64)
    policy: str = Field(..., min_length=1, max_length=MAX_POLICY_CHARS)
    items: list[ModerationItem] = Field(..., min_length=1, max_length=MAX_ITEMS_PER_REQUEST)


def prometheon_file_allowed(name: str) -> bool:
    if name in PROMETHEON_FILE_MANIFEST:
        return True
    return name.startswith(PROMETHEON_SHARD_PREFIX) and name.endswith(PROMETHEON_SHARD_SUFFIX)


def prometheon_verify_repo(repo_path: Path) -> None:
    """Manifest and engine-hash checks. Raises to stop the chute starting."""
    present = {
        str(path.relative_to(repo_path))
        for path in repo_path.rglob("*")
        if path.is_file() and ".cache" not in path.parts
    }
    extra = sorted(name for name in present if not prometheon_file_allowed(name))
    if extra:
        raise RuntimeError(f"repo contains files outside the manifest: {', '.join(extra)}")

    engine_path = repo_path / PROMETHEON_ENGINE_SCRIPT
    if not engine_path.is_file():
        raise RuntimeError(f"repo is missing {PROMETHEON_ENGINE_SCRIPT}")

    digest = hashlib.sha256()
    with engine_path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            digest.update(chunk)
    if digest.hexdigest() != PROMETHEON_CANONICAL_ENGINE_SHA256:
        raise RuntimeError(
            f"{PROMETHEON_ENGINE_SCRIPT} does not match the canonical engine (hash mismatch)"
        )


def prometheon_load_engine(repo_path: Path) -> Any:
    """Import the verified engine and construct it."""
    engine_path = repo_path / PROMETHEON_ENGINE_SCRIPT
    spec = importlib.util.spec_from_file_location("prometheon_engine", engine_path)
    if spec is None or spec.loader is None:
        raise RuntimeError("could not load the engine module")
    module = importlib.util.module_from_spec(spec)
    sys.modules["prometheon_engine"] = module
    spec.loader.exec_module(module)
    return getattr(module, PROMETHEON_ENGINE_CLASS)(str(repo_path))


def prometheon_read_deploy_config(repo_path: Path) -> dict[str, Any]:
    config_path = repo_path / PROMETHEON_REPO_CONFIG
    if not config_path.is_file():
        raise RuntimeError(f"repo is missing {PROMETHEON_REPO_CONFIG}")
    parsed = safe_load(config_path.read_text(encoding="utf-8"))
    if not isinstance(parsed, dict):
        raise RuntimeError(f"{PROMETHEON_REPO_CONFIG} must be a mapping")
    return parsed


def prometheon_apply(cls: Any, config: dict[str, Any]) -> Any:
    """Build an SDK object from declared config, ignoring unknown keys."""
    instance = cls()
    for key, value in config.items():
        method = getattr(instance, key, None)
        if callable(method):
            instance = method(value) if not isinstance(value, dict) else method(**value)
    return instance


_repo_path = Path(snapshot_download(PROMETHEON_HF_REPO, revision=PROMETHEON_HF_REVISION))
prometheon_verify_repo(_repo_path)
_deploy_config = prometheon_read_deploy_config(_repo_path)

image = prometheon_apply(Image, dict(_deploy_config.get("Image", {})))
node_selector = prometheon_apply(NodeSelector, dict(_deploy_config.get("NodeSelector", {})))

chute = Chute(
    username=PROMETHEON_CHUTES_USER,
    name=PROMETHEON_CHUTE_ID,
    image=image,
    node_selector=node_selector,
)

_engine: Any = None


@chute.on_startup()
async def prometheon_startup(self: Any) -> None:
    global _engine
    _engine = prometheon_load_engine(_repo_path)
    _engine.load()


@chute.cord(public_api_path="/health", method="GET")
async def health(self: Any) -> dict[str, Any]:
    """Liveness plus provenance.

    Reports the repo and revision actually loaded, so a validator compares them
    against the on-chain commitment rather than trusting platform metadata.
    """
    return {
        "status": "ok" if _engine is not None else "loading",
        "wrapper_version": WRAPPER_VERSION,
        "hf_repo": PROMETHEON_HF_REPO,
        "hf_revision": PROMETHEON_HF_REVISION,
    }


@chute.cord(public_api_path="/moderate", method="POST")
async def moderate(self: Any, request: ModerationRequest) -> dict[str, Any]:
    """Judge each item against the supplied policy."""
    if _engine is None:
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE, detail="engine still loading"
        )

    result = _engine.moderate(
        request.policy, [{"id": item.id, "content": item.content} for item in request.items]
    )
    return {
        "wrapper_version": WRAPPER_VERSION,
        "policy_version": request.policy_version,
        "verdicts": [
            {"id": verdict.item_id, "violates": verdict.violates} for verdict in result.verdicts
        ],
        "usage": {
            "prompt_tokens": result.prompt_tokens,
            "completion_tokens": result.completion_tokens,
            "items": len(result.verdicts),
        },
    }
